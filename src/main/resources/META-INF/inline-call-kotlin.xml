<idea-plugin>
    <!-- K2 지원 선언(supportsKotlinPluginMode)은 Plugin Verifier 가 메인 plugin.xml 만 보므로 거기에 둔다. -->
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.declarativeInlayProvider
                language="kotlin"
                implementationClass="com.github.sakur35a.functioninlineviewer.InlineCallHintsProvider"
                isEnabledByDefault="true"
                group="OTHER_GROUP"
                providerId="functioninlineviewer.call.body"
                bundle="messages.InlineCallBundle"
                nameKey="inlay.inline.call.name"
                descriptionKey="inlay.inline.call.description"/>
    </extensions>
</idea-plugin>
